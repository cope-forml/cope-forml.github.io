---
layout: base.njk
title: People
permalink: /people/index.html
---

{% macro personCard(p, horizontal=false) %}
  <article class="person-card{{ ' person-card-horizontal' if horizontal else '' }}">
    {% if p.img %}
    <div class="person-portrait" style="--portrait-scale: {{ p.portrait_scale or 1 }}; --portrait-focus: {{ p.portrait_focus or '50% 50%' }};">
      <img src="{{ p.img }}" alt="{{ p.name }}" width="184" height="184" loading="lazy">
    </div>
    {% endif %}
    <div class="person-details">
      <h3>{% if p.web %}<a href="{{ p.web }}" target="_blank" rel="noopener">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</h3>
      <p class="person-affiliation">{% if p.alumni and p.previous_school %}{{ p.previous_school }} → {% endif %}{{ p.role }} · {{ p.school }}</p>
      <div class="person-links">
        <a href="/publications/?author={{ p.name | urlencode }}">Publications</a>
      </div>
    </div>
  </article>
{% endmacro %}

<div class="people-page">
  <div class="page-heading">
    <h1>Group members</h1>
  </div>

  <section class="people-section" aria-labelledby="faculty-heading">
    <div class="people-section-heading">
      <h2 id="faculty-heading" class="section-heading">Faculty</h2>
    </div>
    <div class="people-grid people-grid-horizontal">
      {% for p in people %}
        {% if not p.alumni and p.role == 'Tenure Track Assistant Professor (PI)' %}
          {{ personCard(p, true) }}
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="people-section" aria-labelledby="senior-researchers-heading">
    <div class="people-section-heading">
      <h2 id="senior-researchers-heading" class="section-heading">Senior Researchers</h2>
    </div>
    <div class="people-grid">
      {% for p in people %}
        {% if not p.alumni and (p.role == 'Postdoc' or p.role == 'Fixed Term Assistant Professor') %}
          {{ personCard(p) }}
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <section class="people-section" aria-labelledby="phd-heading">
    <div class="people-section-heading">
      <h2 id="phd-heading" class="section-heading">PhD Students</h2>
    </div>
    <div class="people-grid">
      {% for p in people %}
        {% if not p.alumni and p.role == 'PhD Student' %}
          {{ personCard(p) }}
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% set alumni = people | selectattr('alumni') | list %}
  {% if alumni | length %}
  <section class="people-section" aria-labelledby="alumni-heading">
    <div class="people-section-heading">
      <h2 id="alumni-heading" class="section-heading">Alumni</h2>
    </div>
    <div class="people-grid people-grid-horizontal">
      {% for p in alumni %}
        {{ personCard(p, true) }}
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>

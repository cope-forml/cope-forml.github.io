---
layout: base.njk
title: Blog
permalink: /blog/index.html
---

<div class="page-heading flex flex-wrap items-baseline justify-between gap-4">
  <div><h1>Blog</h1></div>
  <a href="/blog/rss.xml" class="text-sm text-accent hover:underline">Subscribe via RSS</a>
</div>
<div class="news-list blog-list">
  {% for post in collections.blog %}
    <article class="news-item">
      <time datetime="{{ post.date | date('yyyy-LL-dd') }}">{{ post.date | date('dd LLL yyyy') }}</time>
      <div>
        <h2><a href="{{ post.url }}" class="hover:text-accent">{{ post.data.title }}</a></h2>
        {% if post.data.author %}<p class="post-author">{{ post.data.author }}</p>{% endif %}
        {% if post.data.summary %}<p class="news-prose">{{ post.data.summary }}</p>{% endif %}
        <a href="{{ post.url }}" class="text-link post-link">Read more</a>
      </div>
    </article>
  {% else %}
    <p class="text-gray-500">No blog posts yet.</p>
  {% endfor %}
</div>

---
layout: base.njk
title: Publications
permalink: /publications/index.html
---
{% set papers = collections.publications | sort(attribute='entryTags.year', reverse=true) %}
{% set topicsL  = topics %}
{# Conference/journal mapping: [label, colour, fullname, bibtex type] #}
{% set venueMap = {
  'neurips':    ['NeurIPS',  'bg-green-500',   'Conference on Neural
  Information Processing Systems', 'booktitle'],
  'soda':    ['SODA',  'bg-rose-500',   'Symposium on Discrete Algorithms', 'booktitle'],
  'iclr':       ['ICLR',     'bg-emerald-500', 'International Conference on Learning Representations', 'booktitle'],
  'icml':       ['ICML',     'bg-blue-500',    'International Conference on Machine Learning', 'booktitle'],
  'aistats':    ['AISTATS',  'bg-indigo-500',  'Artificial Intelligence and Statistics', 'booktitle'],
  'colt':       ['COLT',     'bg-cyan-500',    'Conference on Learning Theory', 'booktitle'],
  'tmlr':       ['TMLR',     'bg-purple-500',  'Transactions on Machine Learning Research', 'journal'],
  'eaamo':      ['EAAMO',    'bg-pink-500',    'Equity and Access in Algorithms, Mechanisms, and Optimization', 'booktitle'],
  'tpdp':       ['TPDP',     '', 'Theory and Practice of Differential Privacy', 'booktitle'],
  'forc':       ['FORC',     '', 'Foundations of Responsible Computing', 'booktitle'],
  'arxiv':      ['Preprint', 'bg-gray-500',    'arXiv Preprint', 'preprint'],
  'preprint':   ['Preprint', 'bg-gray-500',    'Preprint', 'preprint']
} %}
{% set extraVenueMap = {
  'tpdp': ['TPDP', 'bg-orange-500'],
  'memfm': ['MemFM Workshop (ICML)', 'bg-blue-500'],
  'forc': ['FORC', 'bg-teal-600'],
  'spotlight': ['Spotlight', 'bg-amber-500'],
  'oral': ['Oral', 'bg-amber-500']
} %}

<div class="page-heading"><h1>Publications</h1></div>

<div class="publications-layout">
  <!-- Filter panel -->
  <aside class="publication-filters">
    <input id="search-input" aria-label="Search publications by title or author" type="search" placeholder="Search title or author" class="w-full border focus:ring-2 ring-accent rounded-lg px-3 py-2 text-sm mb-6" />
    <h2 class="text-sm font-semibold mb-3 text-gray-600">Topics</h2>
    <div class="flex flex-wrap gap-2">
      <button class="chip chip-active" data-topic="all">All</button>
      {% for t in topicsL %}
        <button class="chip" data-topic="{{ t.id }}">{{ t.name }}</button>
      {% endfor %}
    </div>
    <div id="active-filters" class="active-publication-filters" hidden>
      <button type="button" id="author-filter" class="selected-filter" hidden></button>
      <button type="button" id="venue-filter" class="selected-filter" hidden></button>
      <button type="button" id="clear-filters" class="clear-publication-filters">Clear filters</button>
    </div>
  </aside>

  <!-- Paper list -->
  <section class="publication-list" id="paper-container">
    <p id="no-results" class="hidden text-gray-600" role="status">No matching publications in the current group bibliography.</p>
    {% set yr = 0 %}
    {% for p in papers %}
      {% if p.entryTags.year != yr %}
        {% set yr = p.entryTags.year %}
        <h2 class="sticky-year">{{ yr }}</h2>
      {% endif %}

      {# Venue tag logic #}
      {% set venueRaw = p.entryTags.journal or p.entryTags.booktitle or '' %}
      {% set venue = venueRaw | lower %}
      {% set venueExtra = p.entryTags.venueextra or '' %}
      {% set extraVenueTokens = venueExtra.split(',') if venueExtra else [] %}
      {% set venueKey = '' %}
      {% set venueTag = venueRaw %}
      {% set venueClass = 'bg-accent' %}
      {% set venueFull = venueRaw %}
      {% for key, val in venueMap %}
        {% if not venueKey and key in venue %}
          {% set venueKey = key %}
          {% set venueTag = val[0] %}
          {% set venueClass = val[1] %}
          {% set venueFull = val[2] %}
        {% endif %}
      {% endfor %}
      {% if not venueKey %}
        {% set venueKey = venueRaw %}
      {% endif %}

      <article id="{{ p.slug }}" class="paper-card" data-authors="{{ p.entryTags.author | escape }}" data-topics="{{ p.topics | join(',') }}" data-tags="{{ p.tags | join(',') }}">
        <div class="paper-content">
          <h3 class="title">{{ p.entryTags.title }}</h3>
          <p class="authors">
            {%- for author in p.entryTags.author.split(' and ') -%}
              {%- set parts = author.split(',') -%}
              {%- if parts | length == 2 -%}
                <span class="paper-author">{{ parts[1].trim() }} {{ parts[0].trim() }}</span>{% if not loop.last %}, {% endif %}
              {%- else -%}
                <span class="paper-author">{{ author }}</span>{% if not loop.last %}, {% endif %}
              {%- endif -%}
            {%- endfor -%}
          </p>
<div class="flex flex-wrap items-center gap-2 mb-1">
  <button type="button" class="venue-label venue-filter" data-venue="{{ 'preprint' if venueKey == 'arxiv' else venueKey }}" aria-label="Filter by {{ venueTag }}" aria-pressed="false">
    {{ venueTag }}
  </button>
  {% for extraVenue in extraVenueTokens %}
    {% set extraVenueKey = extraVenue.trim() | lower %}
    {% if extraVenueKey and extraVenueKey in extraVenueMap and extraVenueMap[extraVenueKey][0] != venueTag %}
  {% if extraVenueKey == 'oral' or extraVenueKey == 'spotlight' %}
  <span class="paper-distinction" data-distinction="{{ extraVenueKey }}">
    {{ extraVenueMap[extraVenueKey][0] }}
  </span>
  {% else %}
  <button type="button" class="venue-label venue-filter" data-venue="{{ extraVenueKey }}" aria-label="Filter by {{ extraVenueMap[extraVenueKey][0] }}" aria-pressed="false">{{ extraVenueMap[extraVenueKey][0] }}</button>
  {% endif %}
    {% endif %}
  {% endfor %}
  {% if 'tpdp' in venue and venueTag != 'TPDP' and 'tpdp' not in (venueExtra | lower) %}
  <button type="button" class="venue-label venue-filter" data-venue="tpdp" aria-label="Filter by TPDP" aria-pressed="false">
    {{ extraVenueMap['tpdp'][0] }}
  </button>
  {% endif %}
  <span class="text-xs text-gray-500">
    {{ 'Arxiv' if venueKey == 'arxiv' or venueKey == 'preprint' else venueFull }} ({{ p.entryTags.year }})
  </span>
</div>

<div class="actions flex flex-wrap gap-2 text-xs mb-3">
            {% if p.entryTags.pdf %}<a href="{{ p.entryTags.pdf | url }}" aria-label="PDF" class="action-btn">PDF</a>{% endif %}
            {% if p.entryTags.code %}<a href="{{ p.entryTags.code }}" aria-label="Code" class="action-btn">Code</a>{% endif %}
            {% if p.entryTags.video %}<a href="{{ p.entryTags.video }}" aria-label="Video" class="action-btn">Video</a>{% endif %}
            {% if p.entryTags.arxiv %}
              {% if p.entryTags.arxiv | string | slice(0,4) == 'http' %}
                <a href="{{ p.entryTags.arxiv }}" aria-label="arXiv" class="action-btn">arXiv</a>
              {% else %}
                <a href="https://arxiv.org/abs/{{ p.entryTags.arxiv }}" aria-label="arXiv" class="action-btn">arXiv</a>
              {% endif %}
            {% endif %}
            <button class="action-btn bibtex-btn" data-bibtex="{{ p.bibtex | escape }}">BibTeX</button>
          </div>
          
          <div class="tags flex flex-wrap gap-1">
            {% for tag in p.tags %}<button class="tag" data-tag="{{ tag }}">{{ tag }}</button>{% endfor %}
          </div>
        </div>
      </article>
    {% endfor %}
  </section>
</div>

<script>
  // Member links filter by a complete author name, independently of keyword search.
  const memberNames = [{% for person in people %}{{ person.name | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}];
  function normalizeAuthor(name) {
    const parts = name.split(',');
    const fullName = parts.length === 2 ? `${parts[1]} ${parts[0]}` : name;
    return fullName.normalize('NFD')
      .replace(/\p{M}/gu, '')
      .replace(/[{}]/g, '')
      .replace(/[\u2010-\u2015\u2212]/g, '-')
      .trim().replace(/\s+/g, ' ').toLowerCase();
  }
  function getQueryParam(name) {
    return new URLSearchParams(window.location.search).get(name);
  }
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('.paper-author').forEach(span => {
      const member = memberNames.find(name => normalizeAuthor(name) === normalizeAuthor(span.textContent));
      if (!member) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'group-author';
      button.textContent = span.textContent;
      button.dataset.author = member;
      button.setAttribute('aria-label', `Filter papers by ${member}`);
      button.setAttribute('aria-pressed', 'false');
      span.replaceWith(button);
    });
    let author = getQueryParam("author");
    if (author) {
      // Keep old first-name member links working without matching unrelated authors.
      const legacyMatches = memberNames.filter(name =>
        normalizeAuthor(name).split(' ')[0] === normalizeAuthor(author));
      if (legacyMatches.length === 1) author = legacyMatches[0];
      authorFilter = normalizeAuthor(author);
      authorLabel = memberNames.find(name => normalizeAuthor(name) === authorFilter) || author;
    }
    venueFilter = getQueryParam('venue') || '';
    apply();
    // BibTeX copy handler
    document.querySelectorAll('.bibtex-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        navigator.clipboard.writeText(btn.dataset.bibtex);
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'BibTeX'; }, 1200);
      });
    });
  });

  // Filtering
  const chips=document.querySelectorAll('.chip');
  const cards=document.querySelectorAll('.paper-card');
  const searchInput=document.getElementById('search-input');
  let topic='all', q='', authorFilter='', authorLabel='', venueFilter='';
  function apply(){
    const query = q.toLowerCase();
    let visibleCount = 0;
    cards.forEach(c=>{
      const topics = c.dataset.topics.toLowerCase().split(',').map(s=>s.trim());
      const matchesAuthor = !authorFilter || c.dataset.authors.split(/\s+and\s+/)
        .some(author => normalizeAuthor(author) === authorFilter);
      const matchesVenue = !venueFilter || Array.from(c.querySelectorAll('[data-venue]'))
        .some(button => button.dataset.venue === venueFilter);
      const show = (topic==='all' || topics.includes(topic)) && matchesAuthor && matchesVenue &&
                   c.textContent.toLowerCase().includes(query);
      if (show) visibleCount++;
      c.classList.toggle('hidden', !show);
      c.classList.toggle('opacity-0', !show);
      c.classList.toggle('scale-95', !show);
    });
    document.getElementById('no-results').classList.toggle('hidden', visibleCount > 0);
    const authorButton = document.getElementById('author-filter');
    authorButton.hidden = !authorFilter;
    authorButton.textContent = `${authorLabel} ×`;
    authorButton.setAttribute('aria-label', `Remove author filter: ${authorLabel}`);
    const venueButton = document.getElementById('venue-filter');
    const venueLabel = Array.from(document.querySelectorAll('.venue-filter')).find(b => b.dataset.venue === venueFilter)?.textContent.trim() || venueFilter;
    venueButton.hidden = !venueFilter;
    venueButton.textContent = `${venueLabel} ×`;
    venueButton.setAttribute('aria-label', `Remove venue filter: ${venueLabel}`);
    document.getElementById('active-filters').hidden = !(authorFilter || venueFilter || q || topic !== 'all');
    document.querySelectorAll('.group-author').forEach(b => b.setAttribute('aria-pressed', String(normalizeAuthor(b.dataset.author) === authorFilter)));
    document.querySelectorAll('.venue-filter').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.venue === venueFilter)));
    chips.forEach(b => {
      b.classList.toggle('chip-active', b.dataset.topic === topic);
      b.setAttribute('aria-pressed', String(b.dataset.topic === topic));
    });
    document.querySelectorAll('.sticky-year').forEach(heading => {
      let next = heading.nextElementSibling;
      let hasVisiblePaper = false;
      while (next && !next.classList.contains('sticky-year')) {
        if (next.classList.contains('paper-card') && !next.classList.contains('hidden')) hasVisiblePaper = true;
        next = next.nextElementSibling;
      }
      heading.classList.toggle('hidden', !hasVisiblePaper);
    });
  }
  chips.forEach(btn=>btn.onclick=()=>{chips.forEach(b=>b.classList.remove('chip-active'));btn.classList.add('chip-active');topic=btn.dataset.topic;apply();});
  searchInput.oninput=()=>{q=searchInput.value;apply();};
  document.getElementById('author-filter').onclick=()=>{authorFilter='';authorLabel='';apply();};
  document.getElementById('venue-filter').onclick=()=>{venueFilter='';apply();};
  document.getElementById('clear-filters').onclick=()=>{topic='all';q='';authorFilter='';authorLabel='';venueFilter='';searchInput.value='';apply();};
  document.getElementById('paper-container').addEventListener('click',e=>{
    const author = e.target.closest('.group-author');
    const venue = e.target.closest('.venue-filter');
    const tag = e.target.closest('.tag');
    if (author) {authorLabel=author.dataset.author;authorFilter=normalizeAuthor(authorLabel);}
    else if (venue) {venueFilter=venue.dataset.venue;}
    else if (tag) {searchInput.value=tag.dataset.tag;q=tag.dataset.tag;}
    else return;
    apply();
  });
</script>

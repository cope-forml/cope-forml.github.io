---
layout: base.njk
title: News
permalink: /news/index.html
---

<div class="page-heading">
  <h1>News</h1>
</div>
<div class="news-list archive-news">
  {% for n in collections.news %}
    <article class="news-item">
      <time datetime="{{ n.date | date('yyyy-LL-dd') }}">{{ n.date | date('dd LLL yyyy') }}</time>
      <div>
        <h2>{{ n.data.title }}</h2>
        <div class="news-prose">{{ n.templateContent | safe }}</div>
      </div>
    </article>
  {% else %}
    <p class="text-gray-500">No recent news to display.</p>
  {% endfor %}
</div>

---
layout: base.njk
title: Home
---

<section class="home-intro" aria-labelledby="group-name">
  <h1 id="group-name">Foundations of Responsible Machine Learning</h1>
  <p>We are a research group at the <strong>University of Copenhagen</strong> developing principled methods at the intersection of privacy, robustness, learning theory, and generally all aspects of responsible machine learning.</p>
  <figure class="research-photo">
    <div class="research-photo-window" data-board-frame>
      <noscript><img class="whiteboard-photo" src="{{ '/assets/images/placeholder-hero.jpg' | url }}" alt="Mathematical notes on the group's whiteboard" width="2636" height="1984" fetchpriority="high"></noscript>
    </div>
  </figure>
  <template id="home-board-options">
    {% for board in homeBoards %}
      <img class="whiteboard-photo" src="{{ board.src | url }}" alt="{{ board.alt }}" style="--board-position: {{ board.position }}; --board-scale: {{ board.scale }};" fetchpriority="high">
    {% endfor %}
  </template>
  <script src="{{ '/assets/home-board.js' | url }}" defer></script>
</section>

<section class="home-news" aria-labelledby="news-heading">
  <div class="section-intro">
    <h2 id="news-heading">News</h2>
    <a class="text-link" href="{{ '/news/' | url }}">All news</a>
  </div>
  <div class="news-list">
    {% for n in collections.news | featuredNews %}
      <article class="news-item">
        <time datetime="{{ n.date | date('yyyy-LL-dd') }}">{{ n.date | date('dd LLL yyyy') }}</time>
        <div>
          <h3>{{ n.data.title }}</h3>
          <div class="news-prose">{{ n.templateContent | safe }}</div>
        </div>
      </article>
    {% else %}
      <p class="text-gray-500">No recent news to display.</p>
    {% endfor %}
  </div>
</section>
